<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes KeyboardKeyboard as a single self-contained file in publish/ at the repo root,
  so the target machine doesn't need .NET installed. Builds for the current OS unless -r is given:

  dotnet publish KeyboardKeyboard -p:PublishProfile=SingleFile
  dotnet publish KeyboardKeyboard -p:PublishProfile=SingleFile -r osx-arm64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)/../publish/</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>

  <!-- SkiaSharp and HarfBuzzSharp ship debug symbols for their native libraries, which nobody running the app needs. -->
  <Target Name="RemoveNativeSymbols" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb;$(PublishDir)libHarfBuzzSharp.pdb" />
  </Target>
</Project>
