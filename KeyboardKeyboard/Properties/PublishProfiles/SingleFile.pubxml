<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes KeyboardKeyboard.exe as a single file in publish\ at the repo root.
  The target machine needs the .NET 10 Desktop Runtime.

  dotnet publish KeyboardKeyboard -p:PublishProfile=SingleFile
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>

  <!-- DryWetMidi also ships its macOS native library, which is never used on Windows. -->
  <Target Name="RemoveMacNativeLibrary" AfterTargets="Publish">
    <Delete Files="$(PublishDir)Melanchall_DryWetMidi_Native64.dylib" />
  </Target>
</Project>
